# Copie para .env e preencha. O .env está no .gitignore: NUNCA o envie ao
# repositório (contém senha do banco e chaves). Na Vercel, cadastre as
# mesmas variáveis em Settings > Environment Variables.

# --- Obrigatória ---------------------------------------------------------
# PostgreSQL (local ou Neon). Ex. local: postgresql://postgres@127.0.0.1:5432/trashtalker
DATABASE_URL=

# --- Funcionalidades ------------------------------------------------------
# Respostas da IA e o botão "ouvir" (Gemini). Sem ela o app abre, mas
# enviar mensagem devolve "Não foi possível falar com a IA agora".
GEMINI_API_KEY=

# Chave Fernet do 2FA (Google Authenticator). Gere UMA vez por ambiente e
# guarde num cofre de senhas - perder a chave tranca as contas com 2FA:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Origem pública do site (usada no link do e-mail de redefinição e na
# checagem de origem das requisições). Em produção: https://seu-dominio
FRONTEND_ORIGIN=http://localhost:5000

# E-mail de redefinição de senha (SMTP com STARTTLS, ex.: porta 587).
# Sem isso, em desenvolvimento o link é impresso no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Execução --------------------------------------------------------------
# production = cookie de sessão "Secure" e link de reset nunca no log.
# (Na Vercel isso já vale automaticamente por causa de VERCEL=1.)
FLASK_ENV=development
# Servidor local (python app.py). Padrão seguro: só esta máquina, sem debugger.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# --- Testes ------------------------------------------------------------------
# Banco SEPARADO: os testes apagam todas as tabelas. Ver docs/testes.md.
TEST_DATABASE_URL=
